# Public base URL of the READ-ONLY Dashboard API (FastAPI: atp.dashboard.api).
# Leave EMPTY for a public deployment with no reachable backend — the dashboard then shows
# NO DATA everywhere (never fabricated). Point it at a tunnel/host that exposes the backend
# when you want live read-only data. NEVER put a localhost:4002 (IB Gateway) URL here — the
# frontend must not reach the broker directly.
NEXT_PUBLIC_API_URL=
# Deprecated alias (still honored as a fallback):
NEXT_PUBLIC_API_BASE_URL=

# Reserved for a future backend push channel (WebSocket/SSE). The backend is REST-only today,
# so the dashboard polls; set this once a WS endpoint exists. Never an IB Gateway URL.
NEXT_PUBLIC_WS_URL=

# Poll interval in milliseconds for the read-only snapshot (default 4000, floor 1000).
NEXT_PUBLIC_POLL_MS=4000

# Owner token for the protected emergency-stop / resume controls. This is read by the BACKEND
# only (atp.dashboard.api). It must NOT be a NEXT_PUBLIC_* var and must never be committed.
# Placeholder here for documentation only; set the real value in the backend environment.
ATP_DASHBOARD_TOKEN=

# Site-wide HTTP Basic Auth (middleware.ts). Set BASIC_AUTH_PASSWORD to lock the ENTIRE site
# (all routes, all domains) behind a login prompt. Server-side only — never exposed to the
# browser, never committed. Unset ⇒ site is open (local dev). Set both in Vercel (Production +
# Preview) to protect the public deployment. Username defaults to "admin" if unset.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=

[Unit]
Description=ATP research intel collection (§ R3.1A — forward-only immutable AI-validation snapshot)
Documentation=https://github.com/soheylghaemian-hue/AITrading-
After=network-online.target docker.service
Wants=network-online.target
# The data stack (PostgreSQL + Redis) runs in Docker; the app connects over loopback.
# One-shot. Snapshots the just-completed US session ONCE per symbol, inside the narrow post-close window
# only; outside it the session is honestly skipped (SAMPLE_SKIPPED), never backdated. RESEARCH DATA ONLY:
# never trades, never places an order, never touches IBKR/execution/broker, never writes live ohlc_bars.
# Fails closed (exit 1) on an unverifiable deployed commit and (exit 2) on missing DB configuration.

[Service]
Type=oneshot
User=atp
Group=atp
WorkingDirectory=/opt/atp/app
Environment=PYTHONPATH=/opt/atp/app/src
EnvironmentFile=/opt/atp/atp.env
ExecStart=/opt/atp/app/.venv/bin/python -m atp.research.intel.worker collect
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/atp/data
ProtectHome=true
PrivateTmp=true

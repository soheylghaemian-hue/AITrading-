[Unit]
Description=ATP Trading Core + Execution Service (Phase C)
Documentation=https://github.com/soheylghaemian-hue/AITrading-
After=network-online.target docker.service atp-marketdata.service
Wants=network-online.target
# Starts alongside Market Data; if MD is down the Trading Core fails closed on stale market-data.

[Service]
Type=simple
User=atp
Group=atp
WorkingDirectory=/opt/atp/app
Environment=PYTHONPATH=/opt/atp/app/src
# Durable Paper Canary is opt-in only. atp.env may override the first flag with the exact literal
# `true`; live broker execution must remain the exact literal `false` for the canary to accept work.
Environment=ATP_DURABLE_PAPER_CANARY_ENABLED=false
Environment=BROKER_EXECUTION_ENABLED=false
Environment=ATP_PAPER_CANARY_OWNER_PORT=9112
EnvironmentFile=/opt/atp/atp.env
ExecStart=/opt/atp/app/.venv/bin/python -m atp.services.trading
Restart=on-failure
RestartSec=2
# A restart NEVER auto-resumes RUNNING — recover() lands in RECOVERY_REQUIRED; human ARM required.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/atp
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

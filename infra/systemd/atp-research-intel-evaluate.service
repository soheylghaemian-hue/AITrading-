[Unit]
Description=ATP research intel evaluation (§ R3.1A — mature outcomes against COMPLETED datasets)
Documentation=https://github.com/soheylghaemian-hue/AITrading-
After=network-online.target docker.service atp-research-intel-collect.service
Wants=network-online.target
# The data stack (PostgreSQL + Redis) runs in Docker; the app connects over loopback.
# One-shot. Matures pending snapshot outcomes ONLY from immutable COMPLETED research datasets — never from
# live ohlc_bars, never from a fabricated price. RESEARCH DATA ONLY: never trades, never places an order,
# never touches IBKR/execution/broker. Fails closed (exit 1) on an unverifiable deployed commit and
# (exit 2) on missing DB configuration.

[Service]
Type=oneshot
User=atp
Group=atp
WorkingDirectory=/opt/atp/app
Environment=PYTHONPATH=/opt/atp/app/src
EnvironmentFile=/opt/atp/atp.env
ExecStart=/opt/atp/app/.venv/bin/python -m atp.research.intel.worker evaluate
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/atp/data
ProtectHome=true
PrivateTmp=true

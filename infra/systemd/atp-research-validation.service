[Unit]
Description=ATP research validation run (§ R3.1A — immutable preregistered-gate evaluation)
Documentation=https://github.com/soheylghaemian-hue/AITrading-
After=network-online.target docker.service atp-research-intel-evaluate.service
Wants=network-online.target
# The data stack (PostgreSQL + Redis) runs in Docker; the app connects over loopback.
# One-shot. Freezes the current matured-outcome set into an immutable validation run; the run is COMPLETED
# only when the preregistered evidence gate passes, otherwise INSUFFICIENT — never a fabricated result.
# RESEARCH DATA ONLY: never trades, never places an order, never touches IBKR/execution/broker. Fails
# closed (exit 1) on an unverifiable deployed commit and (exit 2) on missing DB configuration.

[Service]
Type=oneshot
User=atp
Group=atp
WorkingDirectory=/opt/atp/app
Environment=PYTHONPATH=/opt/atp/app/src
EnvironmentFile=/opt/atp/atp.env
ExecStart=/opt/atp/app/.venv/bin/python -m atp.research.validation.worker run
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/atp/data
ProtectHome=true
PrivateTmp=true

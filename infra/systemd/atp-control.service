[Unit]
Description=ATP Control / Observability Service (Phase C)
Documentation=https://github.com/soheylghaemian-hue/AITrading-
After=network-online.target docker.service
Wants=network-online.target
# Deliberately NOT ordered against the trading services: a Control outage must not affect them, and
# they must not depend on Control. Control reads/writes only PostgreSQL.

[Service]
Type=simple
User=atp
Group=atp
WorkingDirectory=/opt/atp/app
Environment=PYTHONPATH=/opt/atp/app/src
# Mirrors Trading Core's fail-closed Paper Canary defaults. Mutations are proxied only to the
# loopback owner; Control never owns execution state.
Environment=ATP_DURABLE_PAPER_CANARY_ENABLED=false
Environment=BROKER_EXECUTION_ENABLED=false
Environment=ATP_PAPER_CANARY_OWNER_PORT=9112
EnvironmentFile=/opt/atp/atp.env
ExecStart=/opt/atp/app/.venv/bin/python -m atp.services.control
Restart=on-failure
RestartSec=2
# Control never trades; after its own restart it calls recover() too (never auto-RUNNING).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/atp
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

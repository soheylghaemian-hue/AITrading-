[Unit]
Description=ATP AI Outcome Lifecycle Controller (Phase G3.2 — read-only outcome tracking)
Documentation=https://github.com/soheylghaemian-hue/AITrading-
After=network-online.target docker.service
Wants=network-online.target
# The Outcome Scheduler: checks PENDING predictions daily and measures 1/3/5/20-trading-day forward
# returns from real OHLC into the immutable ai_prediction_outcomes. No external fetch. Evaluation only
# — never trades, never generates orders, never touches IBKR/execution/broker, holds no credentials.

[Service]
Type=simple
User=atp
Group=atp
WorkingDirectory=/opt/atp/app
Environment=PYTHONPATH=/opt/atp/app/src
EnvironmentFile=/opt/atp/atp.env
ExecStart=/opt/atp/app/.venv/bin/python -m atp.services.ai_outcome_tracker
Restart=always
RestartSec=5
# Fail-closed + restart-safe: outcomes are immutable (ON CONFLICT DO NOTHING) so a restart never
# re-measures or rewrites history; no OHLC → PENDING (never a fabricated outcome). A DB error records
# nothing; systemd restarts the process.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/atp
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

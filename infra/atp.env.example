# Phase D0 — server-side secrets for the data stack. COPY to /opt/atp/atp.env on the VM, fill with
# STRONG random values (the bootstrap generates them if this file is absent), chmod 600, root:atp.
# NEVER commit the real file. NEVER put these in Git, the frontend, NEXT_PUBLIC_*, or logs.

# PostgreSQL superuser (admin only; the app does NOT use this)
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=CHANGE_ME_super

# Production application role + database
ATP_PROD_DB=atp_prod
ATP_APP_USER=atp_app
ATP_APP_PASSWORD=CHANGE_ME_app

# Test role + database (Phase B.5 integration suite only)
ATP_TEST_DB=atp_test
ATP_TEST_USER=atp_test
ATP_TEST_PASSWORD=CHANGE_ME_test

# Redis (bus/cache only — never authoritative)
REDIS_PASSWORD=CHANGE_ME_redis

# Convenience DSNs (loopback; the test DSN drives the integration suite)
# ATP_DATABASE_URL=postgresql://atp_app:CHANGE_ME_app@127.0.0.1:5432/atp_prod
# ATP_TEST_POSTGRES_DSN=postgresql://atp_test:CHANGE_ME_test@127.0.0.1:5432/atp_test

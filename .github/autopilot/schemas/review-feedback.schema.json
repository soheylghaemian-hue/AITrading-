{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigbay.invalid/schemas/review-feedback.schema.json",
  "title": "Goal-bound unresolved review findings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "goal_id",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "unresolved_review_findings"
    },
    "goal_id": {
      "$ref": "#/$defs/safe_id"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 19,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "goal_id": {
            "const": "trader-brain-learn-v1"
          }
        }
      },
      "then": {},
      "else": {
        "properties": {
          "findings": {
            "maxItems": 16,
            "items": {
              "properties": {
                "sources": {
                  "maxItems": 8
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "single_line_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "job_id",
        "stage",
        "base_sha"
      ],
      "properties": {
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "job_id": {
          "type": "integer",
          "minimum": 1
        },
        "stage": {
          "description": "artifact_audit records trusted independent reproduction against the immutable artifact associated with the referenced run and job; it does not assert that the model review emitted the finding text.",
          "enum": [
            "artifact_audit",
            "gate",
            "initial_review",
            "final_review"
          ]
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\\\)(?!.*//)[^\\u0000-\\u001f\\u007f]+$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "title",
        "detail",
        "location",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safe_id"
        },
        "severity": {
          "enum": [
            "P0",
            "P1"
          ]
        },
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/single_line_text"
            },
            {
              "maxLength": 200
            }
          ]
        },
        "detail": {
          "allOf": [
            {
              "$ref": "#/$defs/single_line_text"
            },
            {
              "maxLength": 3000
            }
          ]
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 27,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  }
}
